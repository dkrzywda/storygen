---
import Topbar from "@/components/Topbar.astro";
import GenerateForm from "@/components/generate/GenerateForm";

// Ekran generatora jako jeden komponent, bo stoi pod dwoma adresami: "/" (strona
// glowna) i "/generate". Duplikat markupu rozjechalby sie przy pierwszej zmianie.
---

<div class="bg-app min-h-screen p-4 py-10">
  <div class="mx-auto w-full max-w-xl">
    <Topbar />
    <h1 class="text-ink mb-2 text-3xl font-bold">Storygen</h1>
    <p class="text-ink-muted mb-8 text-sm">
      Wybierz format, podaj temat i wybierz długość. Dowcip zaskoczy puentą, historia zostawi myśl — obydwa zmieszczą
      się w limicie słów.
    </p>

    <div class="border-hairline bg-panel rounded-2xl border p-6 shadow-sm">
      <GenerateForm client:load />
    </div>
  </div>
</div>
