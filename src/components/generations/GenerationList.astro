---
import TitleEditor from "@/components/generations/TitleEditor";
import RatingControls from "@/components/generations/RatingControls";
import type { GenerationFormat } from "@/types";

/**
 * Lista zapisanych generacji — jeden komponent dla historii, rankingu i ulubionych.
 *
 * Trzy niezalezne listy rozjechalyby sie przy pierwszej zmianie: dodanie oceny do
 * historii i zapomnienie o niej w ulubionych to najzwyklejszy sposob, w jaki widoki
 * przestaja pokazywac to samo.
 */

interface Item {
  id: string;
  title: string | null;
  content: string;
  format: string;
  rating: number | null;
  is_favourite: boolean;
  created_at: string;
}

interface Props {
  items: Item[];
  /** Numeracja pozycji — ma sens w rankingu, nie w historii. */
  ranked?: boolean;
  emptyTitle: string;
  emptyHint: string;
}

const { items, ranked = false, emptyTitle, emptyHint } = Astro.props;

function preview(content: string): string {
  const trimmed = content.trim();
  return trimmed.length > 70 ? `${trimmed.slice(0, 70)}…` : trimmed;
}

const FORMAT_LABEL: Record<GenerationFormat, string> = { joke: "Dowcip", story: "Historia" };

function formatLabel(format: string): string {
  return format === "story" || format === "joke" ? FORMAT_LABEL[format] : format;
}

const dateFormat = new Intl.DateTimeFormat("pl-PL", { dateStyle: "long", timeStyle: "short" });
---

{
  items.length === 0 ? (
    <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center backdrop-blur-xl">
      <p class="text-blue-100/80">{emptyTitle}</p>
      <p class="mt-2 text-sm text-blue-100/50">{emptyHint}</p>
    </div>
  ) : (
    <ul class="space-y-3">
      {items.map((item, index) => (
        <li class="rounded-2xl border border-white/10 bg-white/10 p-5 text-white backdrop-blur-xl">
          <div class="flex items-start gap-3">
            {ranked && <span class="mt-0.5 min-w-6 text-center font-mono text-sm text-blue-100/40">{index + 1}.</span>}
            <div class="min-w-0 flex-1">
              <TitleEditor client:load id={item.id} initialTitle={item.title} fallback={preview(item.content)} />
              <div class="mt-3">
                <RatingControls
                  client:load
                  id={item.id}
                  initialRating={item.rating}
                  initialFavourite={item.is_favourite}
                />
              </div>
              <p class="mt-3 text-xs text-blue-100/40">
                {formatLabel(item.format)} · {dateFormat.format(new Date(item.created_at))}
              </p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  )
}
