---
import TitleEditor from "@/components/generations/TitleEditor";
import RatingControls from "@/components/generations/RatingControls";
import DeleteButton from "@/components/generations/DeleteButton";
import type { GenerationFormat } from "@/types";

/**
 * Lista zapisanych generacji — jeden komponent dla historii, rankingu i ulubionych.
 *
 * Trzy niezalezne listy rozjechalyby sie przy pierwszej zmianie: dodanie oceny do
 * historii i zapomnienie o niej w ulubionych to najzwyklejszy sposob, w jaki widoki
 * przestaja pokazywac to samo.
 */

interface Item {
  id: string;
  title: string | null;
  content: string;
  format: string;
  rating: number | null;
  is_favourite: boolean;
  created_at: string;
}

interface Props {
  items: Item[];
  /** Numeracja pozycji — ma sens w rankingu, nie w historii. */
  ranked?: boolean;
  /**
   * Akcja usuwania. Domyslnie WYLACZONA i to jest zamierzone: nowy widok nad ta lista
   * nie powinien dostawac nieodwracalnej akcji przez przypadek, tylko przez decyzje.
   */
  deletable?: boolean;
  emptyTitle: string;
  emptyHint: string;
}

const { items, ranked = false, deletable = false, emptyTitle, emptyHint } = Astro.props;

function preview(content: string): string {
  const trimmed = content.trim();
  return trimmed.length > 70 ? `${trimmed.slice(0, 70)}…` : trimmed;
}

const FORMAT_LABEL: Record<GenerationFormat, string> = { joke: "Dowcip", story: "Historia" };

function formatLabel(format: string): string {
  return format === "story" || format === "joke" ? FORMAT_LABEL[format] : format;
}

const dateFormat = new Intl.DateTimeFormat("pl-PL", { dateStyle: "long", timeStyle: "short" });
---

{
  items.length === 0 ? (
    <div class="border-hairline bg-panel rounded-2xl border p-8 text-center shadow-sm">
      <p class="text-ink-muted">{emptyTitle}</p>
      <p class="text-ink-subtle mt-2 text-sm">{emptyHint}</p>
    </div>
  ) : (
    <ul class="space-y-3">
      {items.map((item, index) => (
        <li class="border-hairline bg-panel text-ink rounded-2xl border p-5 shadow-sm">
          <div class="flex items-start gap-3">
            {ranked && <span class="text-ink-subtle mt-0.5 min-w-6 text-center font-mono text-sm">{index + 1}.</span>}
            <div class="min-w-0 flex-1">
              <TitleEditor client:load id={item.id} initialTitle={item.title} fallback={preview(item.content)} />
              <div class="mt-3">
                <RatingControls
                  client:load
                  id={item.id}
                  initialRating={item.rating}
                  initialFavourite={item.is_favourite}
                />
              </div>
              <div class="mt-3 flex items-end justify-between gap-3">
                <p class="text-ink-subtle text-xs">
                  {formatLabel(item.format)} · {dateFormat.format(new Date(item.created_at))}
                </p>
                <div class="flex items-end gap-3">
                  {/* Bez flagi — link jest nieszkodliwy wszedzie i daje panelowi (ranking, ulubione)
                      droge do pelnej tresci, ktorej dotad nie mial. Okno zyje pod /generations. */}
                  <a
                    href={`/generations?open=${item.id}`}
                    class="text-brand hover:text-brand-strong text-xs transition-colors hover:underline"
                  >
                    Otwórz
                  </a>
                  {deletable && <DeleteButton client:load id={item.id} />}
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  )
}
