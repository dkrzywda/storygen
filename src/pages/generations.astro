---
import Layout from "@/layouts/Layout.astro";
import TitleEditor from "@/components/generations/TitleEditor";
import { createClient } from "@/lib/supabase";

// Trasa jest w PROTECTED_ROUTES, wiec middleware odsyla anonimow do logowania,
// zanim ten kod sie wykona.
const supabase = createClient(Astro.request.headers, Astro.cookies);

// RLS ogranicza wynik do wlasnych wierszy — bez zadnego filtra po user_id.
// Filtr w kodzie dawalby ten sam wynik dla poprawnej polityki i maskowal bledna.
const { data: generations } = supabase
  ? await supabase
      .from("generations")
      .select("id, title, content, created_at")
      .order("created_at", { ascending: false })
  : { data: null };

const items = generations ?? [];

function preview(content: string): string {
  const trimmed = content.trim();
  return trimmed.length > 70 ? `${trimmed.slice(0, 70)}…` : trimmed;
}

const dateFormat = new Intl.DateTimeFormat("pl-PL", { dateStyle: "long", timeStyle: "short" });
---

<Layout title="Moje generacje">
  <div class="bg-cosmic min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-2xl">
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Moje generacje
      </h1>
      <p class="mb-8 text-sm text-blue-100/60">
        Widzisz wyłącznie własne teksty. Nadaj im tytuły, żeby łatwiej je odnajdywać.
      </p>

      {
        items.length === 0 ? (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center backdrop-blur-xl">
            <p class="text-blue-100/80">Nie masz jeszcze żadnych generacji.</p>
            <p class="mt-2 text-sm text-blue-100/50">
              Pojawią się tutaj automatycznie, gdy tylko wygenerujesz pierwszy tekst.
            </p>
          </div>
        ) : (
          <ul class="space-y-3">
            {items.map((item) => (
              <li class="rounded-2xl border border-white/10 bg-white/10 p-5 text-white backdrop-blur-xl">
                <TitleEditor client:load id={item.id} initialTitle={item.title} fallback={preview(item.content)} />
                <p class="mt-3 text-xs text-blue-100/40">{dateFormat.format(new Date(item.created_at))}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
