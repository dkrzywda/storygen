---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GenerationList from "@/components/generations/GenerationList.astro";
import { createClient } from "@/lib/supabase";
import { fetchHistory } from "@/lib/generations";

// Trasa jest w PROTECTED_ROUTES, wiec middleware odsyla anonimow do logowania,
// zanim ten kod sie wykona.
const supabase = createClient(Astro.request.headers, Astro.cookies);

// Odczyt nie filtruje po `user_id` — izolacja stoi na RLS. Uzasadnienie w `@/lib/generations`.
const items = supabase ? await fetchHistory(supabase) : [];
---

<Layout title="Moje generacje">
  <div class="bg-app min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-2xl">
      <Topbar />

      <h1 class="text-ink mb-2 text-3xl font-bold">Moje generacje</h1>
      <p class="text-ink-muted mb-8 text-sm">
        Widzisz wyłącznie własne teksty. Nadaj im tytuły, oceń gwiazdkami i oznacz ulubione.
      </p>

      <GenerationList
        items={items}
        emptyTitle="Nie masz jeszcze żadnych generacji."
        emptyHint="Pojawią się tutaj automatycznie, gdy tylko wygenerujesz pierwszy tekst."
      />
    </div>
  </div>
</Layout>
