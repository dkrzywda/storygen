---
import Layout from "@/layouts/Layout.astro";

/**
 * Strona nieznalezionej sciezki.
 *
 * PO CO TEN PLIK ISTNIEJE: Astro ma wbudowana strone 404 po ANGIELSKU (zmierzone
 * na produkcji 2026-09-08: 4319 B, `<html lang="en">`, "404: Not Found"). PRD wymaga
 * interfejsu wylacznie po polsku, wiec ta strona byla naruszeniem NFR niezaleznie
 * od `F-02`.
 *
 * CZEGO TEN PLIK NIE ROBI — sprostowanie ustalenia F2 przegladu, 2026-09-08.
 * Komentarz stal tu wczesniej, ze odmowa dostepu do trasy administratora przepisuje
 * zadanie tutaj przez `ADMIN_ROUTES` w `src/middleware.ts`. TAKIEGO MECHANIZMU NIE MA
 * i nie ma go byc: trasy `/admin` nie istnieje, a roli pilnuje warunek `showAdmin`
 * w `src/pages/dashboard.astro`. Nie zakladaj, ze middleware bramkuje cokolwiek po roli —
 * dokladajac trase administratora, musisz sam zdecydowac, jak ja oslonic.
 *
 * TRESC NIE MOZE ZDRADZAC ISTNIENIA ZADNEJ TRASY ADMINA. Zaden komunikat
 * o uprawnieniach, zadne "byc moze nie masz dostepu" — to by przeciekalo dokladnie
 * to, co FR-015 chroni, gdyby ta strona kiedys znow stala sie celem odmowy.
 *
 * STATUS USTAWIONY JAWNIE, bo `Astro.response.status` nie wynika z nazwy pliku przy
 * renderowaniu przez przepisanie — a bez niego strona bledu wygladalaby jak poprawna
 * odpowiedz dla przegladarki, dla `curl` i dla kazdego narzedzia patrzacego na status.
 */
Astro.response.status = 404;
---

<Layout title="Nie znaleziono strony">
  <div class="bg-app flex min-h-screen items-center justify-center p-4">
    <div class="border-hairline bg-panel text-ink w-full max-w-sm rounded-2xl border p-8 text-center shadow-sm">
      <div class="mb-4 text-5xl">🔍</div>
      <h1 class="text-ink mb-3 text-2xl font-bold">Nie znaleziono strony</h1>
      <p class="text-ink-muted mb-6">Ten adres nie istnieje. Sprawdź, czy nie ma w nim literówki.</p>
      <a href="/" class="text-brand text-sm hover:underline">Wróć do generatora</a>
    </div>
  </div>
</Layout>
