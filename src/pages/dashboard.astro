---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GenerationList from "@/components/generations/GenerationList.astro";
import { createClient } from "@/lib/supabase";
import { fetchFavourites, fetchRanking } from "@/lib/generations";
import { DAILY_APP_CEILING, DAILY_PER_ACCOUNT, fetchUsageToday, type UsageToday } from "@/lib/limits";
import { resetTimeFormat } from "@/lib/generation-labels";
import { logApiError } from "@/lib/api-errors";
import type { GenerationFormat } from "@/types";

// Trasa jest w PROTECTED_ROUTES, wiec middleware odsyla anonimow do logowania.
const supabase = createClient(Astro.request.headers, Astro.cookies);

/**
 * Wykorzystanie limitow (FR-012, FR-013).
 *
 * `null` znaczy "nie wiem", NIE "zero". Zero jest twierdzeniem o stanie, a przy
 * nieudanym odczycie tego stanu nie znamy — pokazanie "0 z 10" byloby liczba
 * wymyslona, i to akurat w kierunku zachecajacym do generowania.
 *
 * Nieudany odczyt NIE wywraca panelu: ranking i ulubione dzialaja bez licznika.
 * To inna decyzja niz w endpoincie, gdzie ten sam blad odmawia generowania —
 * roznica jest taka, ze tam brak licznika znaczy "sufit nie obowiazuje", a tutaj
 * tylko "nie umiem tego pokazac".
 */
let usage: UsageToday | null = null;
if (supabase) {
  try {
    usage = await fetchUsageToday(supabase);
  } catch (error) {
    // Bez tego wpisu nieudany odczyt nie zostawia zadnego sladu — uzytkownik widzi
    // komunikat, a my nie wiemy, ze cos sie stalo.
    logApiError("dashboard", "INTERNAL", error);
  }
}

/**
 * Zakladki jada przez parametry adresu, nie przez wyspe Reacta.
 *
 * Powod jest konkretny: kazda zakladka to inne ZAPYTANIE do bazy, wiec wyspa
 * musialaby i tak wolac serwer. Przy parametrach zakladka ma wlasny adres — da sie
 * ja odswiezyc, wrocic do niej przyciskiem wstecz i wkleic komus link.
 *
 * Wartosci spoza zbioru NIE sa bledem — schodza do domyslnych. Adres wpisuje
 * czlowiek i literowka w `?tab=` nie powinna dawac komunikatu o bledzie.
 */
const tab = Astro.url.searchParams.get("tab") === "favourites" ? "favourites" : "ranking";
const format: GenerationFormat = Astro.url.searchParams.get("format") === "story" ? "story" : "joke";

const items = supabase
  ? tab === "favourites"
    ? await fetchFavourites(supabase)
    : await fetchRanking(supabase, format)
  : [];

const TABS = [
  { key: "ranking", label: "Ranking", href: "/dashboard?tab=ranking&format=joke" },
  { key: "favourites", label: "Ulubione", href: "/dashboard?tab=favourites" },
];

const FORMAT_TABS: { key: GenerationFormat; label: string }[] = [
  { key: "joke", label: "Dowcipy" },
  { key: "story", label: "Historie" },
];

const tabClass = "rounded-lg border px-4 py-2 text-sm transition-colors";
const activeClass = "border-brand bg-brand-soft text-brand-strong";
const idleClass = "border-hairline bg-panel text-ink-muted hover:bg-app";
---

<Layout title="Panel">
  <div class="bg-app min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-2xl">
      <Topbar />

      <h1 class="text-ink mb-2 text-3xl font-bold">Panel</h1>
      <p class="text-ink-muted mb-6 text-sm">Twoje oceny i ulubione. Widzisz wyłącznie własne teksty.</p>

      {
        /* Blok stoi NAD zakladkami, wiec jest widoczny na obu — limit nie nalezy
          ani do rankingu, ani do ulubionych, tylko do konta. */
      }
      <section class="border-hairline bg-panel mb-6 rounded-xl border p-4" aria-label="Wykorzystanie dziennego limitu">
        {
          usage ? (
            <>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <span class="text-ink text-sm font-medium">Twój dzienny limit</span>
                <span class="text-ink-muted text-sm">
                  {usage.own} z {DAILY_PER_ACCOUNT}
                </span>
              </div>
              <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4">
                <span class="text-ink-muted text-sm">Cała aplikacja</span>
                <span class="text-ink-muted text-sm">
                  {usage.app} z {DAILY_APP_CEILING}
                </span>
              </div>
              <p class="text-ink-subtle mt-2 text-xs">
                Oba odnowią się o {resetTimeFormat.format(usage.resetsAt)}. Liczone są próby, więc nieudana generacja
                też zajmuje miejsce.
              </p>
            </>
          ) : (
            <p class="text-ink-muted text-sm">Nie udało się odczytać wykorzystania limitu. Odśwież stronę za chwilę.</p>
          )
        }
      </section>

      <nav class="mb-4 flex gap-2" aria-label="Zakładki panelu">
        {
          TABS.map((entry) => (
            <a href={entry.href} class:list={`${tabClass} ${tab === entry.key ? activeClass : idleClass}`}>
              {entry.label}
            </a>
          ))
        }
      </nav>

      {
        tab === "ranking" && (
          <nav class="mb-6 flex gap-2" aria-label="Format w rankingu">
            {FORMAT_TABS.map((entry) => (
              <a
                href={`/dashboard?tab=ranking&format=${entry.key}`}
                class:list={`${tabClass} ${format === entry.key ? activeClass : idleClass}`}
              >
                {entry.label}
              </a>
            ))}
          </nav>
        )
      }

      {
        tab === "ranking" ? (
          /* Ranking NIE dostaje `deletable` i to jest znaczacy brak, nie zapomnienie:
             ranking jest tablica wynikow do czytania, a zarzadzanie kolekcja dzieje sie
             w historii i w ulubionych. Nie "naprawiaj" tego, dokladajac tu flage. */
          <GenerationList
            items={items}
            ranked
            emptyTitle={
              format === "joke" ? "Żaden dowcip nie ma jeszcze oceny." : "Żadna historia nie ma jeszcze oceny."
            }
            emptyHint="Oceń tekst gwiazdkami w historii albo zaraz po wygenerowaniu — ranking pokazuje tylko ocenione pozycje."
          />
        ) : (
          <GenerationList
            items={items}
            deletable
            emptyTitle="Nie masz jeszcze ulubionych."
            emptyHint="Kliknij serce przy tekście, żeby trafił tutaj."
          />
        )
      }

      <p class="text-ink-subtle mt-8 text-center text-xs">
        <a href="/generations" class="hover:text-ink-muted hover:underline">Zobacz całą historię</a>
      </p>
    </div>
  </div>
</Layout>
