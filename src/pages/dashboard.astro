---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GenerationList from "@/components/generations/GenerationList.astro";
import { createClient } from "@/lib/supabase";
import { fetchFavourites, fetchRanking } from "@/lib/generations";
import type { GenerationFormat } from "@/types";

// Trasa jest w PROTECTED_ROUTES, wiec middleware odsyla anonimow do logowania.
const supabase = createClient(Astro.request.headers, Astro.cookies);

/**
 * Zakladki jada przez parametry adresu, nie przez wyspe Reacta.
 *
 * Powod jest konkretny: kazda zakladka to inne ZAPYTANIE do bazy, wiec wyspa
 * musialaby i tak wolac serwer. Przy parametrach zakladka ma wlasny adres — da sie
 * ja odswiezyc, wrocic do niej przyciskiem wstecz i wkleic komus link.
 *
 * Wartosci spoza zbioru NIE sa bledem — schodza do domyslnych. Adres wpisuje
 * czlowiek i literowka w `?tab=` nie powinna dawac komunikatu o bledzie.
 */
const tab = Astro.url.searchParams.get("tab") === "favourites" ? "favourites" : "ranking";
const format: GenerationFormat = Astro.url.searchParams.get("format") === "story" ? "story" : "joke";

const items = supabase
  ? tab === "favourites"
    ? await fetchFavourites(supabase)
    : await fetchRanking(supabase, format)
  : [];

const TABS = [
  { key: "ranking", label: "Ranking", href: "/dashboard?tab=ranking&format=joke" },
  { key: "favourites", label: "Ulubione", href: "/dashboard?tab=favourites" },
];

const FORMAT_TABS: { key: GenerationFormat; label: string }[] = [
  { key: "joke", label: "Dowcipy" },
  { key: "story", label: "Historie" },
];

const tabClass = "rounded-lg border px-4 py-2 text-sm transition-colors";
const activeClass = "border-brand bg-brand-soft text-brand-strong";
const idleClass = "border-hairline bg-panel text-ink-muted hover:bg-app";
---

<Layout title="Panel">
  <div class="bg-app min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-2xl">
      <Topbar />

      <h1 class="text-ink mb-2 text-3xl font-bold">Panel</h1>
      <p class="text-ink-muted mb-6 text-sm">Twoje oceny i ulubione. Widzisz wyłącznie własne teksty.</p>

      <nav class="mb-4 flex gap-2" aria-label="Zakładki panelu">
        {
          TABS.map((entry) => (
            <a href={entry.href} class:list={`${tabClass} ${tab === entry.key ? activeClass : idleClass}`}>
              {entry.label}
            </a>
          ))
        }
      </nav>

      {
        tab === "ranking" && (
          <nav class="mb-6 flex gap-2" aria-label="Format w rankingu">
            {FORMAT_TABS.map((entry) => (
              <a
                href={`/dashboard?tab=ranking&format=${entry.key}`}
                class:list={`${tabClass} ${format === entry.key ? activeClass : idleClass}`}
              >
                {entry.label}
              </a>
            ))}
          </nav>
        )
      }

      {
        tab === "ranking" ? (
          <GenerationList
            items={items}
            ranked
            emptyTitle={
              format === "joke" ? "Żaden dowcip nie ma jeszcze oceny." : "Żadna historia nie ma jeszcze oceny."
            }
            emptyHint="Oceń tekst gwiazdkami w historii albo zaraz po wygenerowaniu — ranking pokazuje tylko ocenione pozycje."
          />
        ) : (
          <GenerationList
            items={items}
            emptyTitle="Nie masz jeszcze ulubionych."
            emptyHint="Kliknij serce przy tekście, żeby trafił tutaj."
          />
        )
      }

      <p class="text-ink-subtle mt-8 text-center text-xs">
        <a href="/generations" class="hover:text-ink-muted hover:underline">Zobacz całą historię</a>
      </p>
    </div>
  </div>
</Layout>
