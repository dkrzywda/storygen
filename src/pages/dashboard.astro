---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import GenerationList from "@/components/generations/GenerationList.astro";
import { createClient } from "@/lib/supabase";
import { fetchFavourites, fetchRanking } from "@/lib/generations";
import { fetchUsageToday, type UsageToday } from "@/lib/limits";
import { accountDateFormat, resetTimeFormat } from "@/lib/generation-labels";
import { logApiError } from "@/lib/api-errors";
import { isAdmin } from "@/lib/account-role";
import { fetchAccountsOverview } from "@/lib/admin-accounts";
import AccountRoleButton from "@/components/admin/AccountRoleButton";
import type { AccountOverviewRow, GenerationFormat } from "@/types";

// Trasa jest w PROTECTED_ROUTES, wiec middleware odsyla anonimow do logowania.
const supabase = createClient(Astro.request.headers, Astro.cookies);

/**
 * Czy pokazac sekcje administratora (F-02, FR-015).
 *
 * SEKCJA W PANELU, A NIE OSOBNA TRASA `/admin` — i to jest mocniejsze wobec FR-015,
 * nie slabsze. FR-015 wymaga, by odmowa nie ujawniala, ze przeglad kont istnieje.
 * Osobny adres spelnialby to przez WYSILEK: trzeba by go maskowac odpowiedzia
 * nierozroznialna od nieistniejacej sciezki, z pulapka w postaci przekierowania,
 * ktore by go zdradzilo. Tutaj nie ma czego odmawiac, bo nie ma adresu do odgadniecia:
 * nie-admin dostaje panel, admin dostaje panel z jedna sekcja wiecej.
 *
 * OCHRONA TRASY ZOSTAJE W MIDDLEWARE. `/dashboard` jest w `PROTECTED_ROUTES`, wiec
 * regula z CLAUDE.md o middleware-driven auth obowiazuje bez zmian — tutaj rozstrzyga
 * sie tylko, CO strona renderuje, nie CZY wpuszcza.
 *
 * `isAdmin` jest fail-closed, wiec kazde nieoczekiwane `app_metadata` daje `false`
 * i sekcja po prostu nie powstaje.
 */
const showAdmin = isAdmin(Astro.locals.user);

/**
 * Przeglad kont (S-09, FR-014).
 *
 * ODCZYT TYLKO GDY `showAdmin` — konto bez roli nie generuje nawet zapytania.
 * Bramka jest DODATKOWO w samej funkcji SQL (`accounts_overview()` oddaje pusty
 * zbior bez roli `admin`), wiec te dwa sprawdzenia sa nadmiarowe wobec siebie
 * CELOWO: to warstwa w bazie jest granica bezpieczenstwa, a ten warunek tylko
 * oszczedza obrot.
 *
 * `null` znaczy "nie wiem", NIE "brak kont" — dokladnie jak `usage` powyzej. Pusta
 * tablica to inna rzecz: to poprawna odpowiedz bazy, a interfejs musi je rozroznic,
 * bo "nie udalo sie odczytac" i "nie ma zadnych kont" to dwa rozne komunikaty.
 *
 * Nieudany odczyt NIE wywraca panelu: ranking i ulubione nie maja z przegladem
 * nic wspolnego.
 */
/**
 * Wiersz gotowy do wyswietlenia: data juz sformatowana, nie surowy `Date`.
 *
 * USTALENIE F4 PRZEGLADU. Formatowanie MUSI stac w tym samym `try`, co odczyt.
 * Wczesniej `dateFormat.format(...)` stalo w szablonie, czyli POZA blokiem ponizej —
 * a wtedy wartosc nieparsowalna rzucalaby z `Intl.format` przy renderowaniu i wywracala
 * CALA strone, lacznie z rankingiem i ulubionymi, ktore z ta sekcja nie maja nic
 * wspolnego. Ostrozny `try` przy odczycie dawal zludzenie izolacji, ktorej nie bylo.
 *
 * Dlaczego to nie jest paranoja: `auth.users.email` i `created_at` sa nullowalne
 * (`is_nullable = YES`, zmierzone), a wygenerowany `database.types.ts` deklaruje je jako
 * nie-null — typ jest WEZSZY NIZ SCHEMAT. Dzis nieosiagalne, bo rejestracja jest tylko
 * e-mailem i haslem; osiagalne przy logowaniu anonimowym albo po numerze telefonu.
 */
type AccountRowView = AccountOverviewRow & { registeredLabel: string; roleLabel: string };

let accounts: AccountRowView[] | null = null;
if (showAdmin && supabase) {
  try {
    const rows = await fetchAccountsOverview(supabase);
    // OBA etykiety liczone TU, w tym samym `try` co odczyt — nie w szablonie.
    // `lessons.md` § "Degradacja odczytu nie chroni renderowania": `try/catch` przy
    // odczycie chroni tylko odczyt, a formatowanie w szablonie rzucaloby POZA nim
    // i wywracalo cala strone, lacznie z rankingiem i ulubionymi.
    accounts = rows.map((row) => ({
      ...row,
      registeredLabel: accountDateFormat.format(row.registeredAt),
      roleLabel: row.role === "admin" ? "administrator" : "użytkownik",
    }));
  } catch (error) {
    logApiError("dashboard/accounts", "INTERNAL", error);
  }
}

/**
 * Czy lista kont MOGLA zostac obcieta — ustalenie F3 przegladu.
 *
 * Sufit przychodzi Z BAZY, w kolumnie `row_limit`, a nie ze stalej w tym pliku.
 * Wczesniej liczba 200 stala tu drugi raz, obok `limit 200` w SQL: zmiana sufitu
 * w migracji uciszalaby wtedy ten komunikat BEZ ZADNEGO BLEDU, a lista znowu
 * twierdzilaby "widzisz wszystko", gdy widzisz czesc.
 *
 * "MOGLA", nie "zostala": kont moze byc dokladnie tyle, ile sufit — stad ostrozne
 * brzmienie komunikatu.
 */
const accountsTruncated = accounts !== null && accounts.length > 0 && accounts.length === accounts[0].rowLimit;

/**
 * Wykorzystanie limitow (FR-012, FR-013).
 *
 * `null` znaczy "nie wiem", NIE "zero". Zero jest twierdzeniem o stanie, a przy
 * nieudanym odczycie tego stanu nie znamy — pokazanie "0 z 10" byloby liczba
 * wymyslona, i to akurat w kierunku zachecajacym do generowania.
 *
 * Nieudany odczyt NIE wywraca panelu: ranking i ulubione dzialaja bez licznika.
 * To inna decyzja niz w endpoincie, gdzie ten sam blad odmawia generowania —
 * roznica jest taka, ze tam brak licznika znaczy "sufit nie obowiazuje", a tutaj
 * tylko "nie umiem tego pokazac".
 */
let usage: UsageToday | null = null;
if (supabase) {
  try {
    usage = await fetchUsageToday(supabase);
  } catch (error) {
    // Bez tego wpisu nieudany odczyt nie zostawia zadnego sladu — uzytkownik widzi
    // komunikat, a my nie wiemy, ze cos sie stalo.
    logApiError("dashboard", "INTERNAL", error);
  }
}

/**
 * Zakladki jada przez parametry adresu, nie przez wyspe Reacta.
 *
 * Powod jest konkretny: kazda zakladka to inne ZAPYTANIE do bazy, wiec wyspa
 * musialaby i tak wolac serwer. Przy parametrach zakladka ma wlasny adres — da sie
 * ja odswiezyc, wrocic do niej przyciskiem wstecz i wkleic komus link.
 *
 * Wartosci spoza zbioru NIE sa bledem — schodza do domyslnych. Adres wpisuje
 * czlowiek i literowka w `?tab=` nie powinna dawac komunikatu o bledzie.
 */
const tab = Astro.url.searchParams.get("tab") === "favourites" ? "favourites" : "ranking";
const format: GenerationFormat = Astro.url.searchParams.get("format") === "story" ? "story" : "joke";

const items = supabase
  ? tab === "favourites"
    ? await fetchFavourites(supabase)
    : await fetchRanking(supabase, format)
  : [];

const TABS = [
  { key: "ranking", label: "Ranking", href: "/dashboard?tab=ranking&format=joke" },
  { key: "favourites", label: "Ulubione", href: "/dashboard?tab=favourites" },
];

const FORMAT_TABS: { key: GenerationFormat; label: string }[] = [
  { key: "joke", label: "Dowcipy" },
  { key: "story", label: "Historie" },
];

const tabClass = "rounded-lg border px-4 py-2 text-sm transition-colors";
const activeClass = "border-brand bg-brand-soft text-brand-strong";
const idleClass = "border-hairline bg-panel text-ink-muted hover:bg-app";
---

<Layout title="Panel">
  <div class="bg-app min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-2xl">
      <Topbar />

      <h1 class="text-ink mb-2 text-3xl font-bold">Panel</h1>
      <p class="text-ink-muted mb-6 text-sm">Twoje oceny i ulubione. Widzisz wyłącznie własne teksty.</p>

      {
        /* Blok stoi NAD zakladkami, wiec jest widoczny na obu — limit nie nalezy
          ani do rankingu, ani do ulubionych, tylko do konta. */
      }
      <section class="border-hairline bg-panel mb-6 rounded-xl border p-4" aria-label="Wykorzystanie dziennego limitu">
        {
          usage ? (
            <>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <span class="text-ink text-sm font-medium">Twój dzienny limit</span>
                <span class="text-ink-muted text-sm">
                  {usage.own} z {usage.ownLimit}
                </span>
              </div>
              <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4">
                <span class="text-ink-muted text-sm">Cała aplikacja</span>
                <span class="text-ink-muted text-sm">
                  {usage.app} z {usage.appLimit}
                </span>
              </div>
              <p class="text-ink-subtle mt-2 text-xs">
                Oba odnowią się o {resetTimeFormat.format(usage.resetsAt)}. Liczone są próby, więc nieudana generacja
                też zajmuje miejsce.
              </p>
            </>
          ) : (
            <p class="text-ink-muted text-sm">Nie udało się odczytać wykorzystania limitu. Odśwież stronę za chwilę.</p>
          )
        }
      </section>

      {
        /* Sekcja administratora. Stoi NAD zakladkami, obok bloku limitu, bo — tak jak on —
          dotyczy konta, nie wybranej zakladki. Zwykle konto nie widzi tu NICZEGO: zadnego
          napisu, zadnej ramki, zadnego sladu, ze cos takiego istnieje. */
      }
      {
        showAdmin && (
          <section class="border-hairline bg-panel mb-6 rounded-xl border p-4" aria-label="Sekcja administratora">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <span class="text-ink text-sm font-medium">Administracja</span>
              <span class="text-ink-subtle text-xs">
                {accounts === null ? "Twoje konto ma rolę administratora" : `${String(accounts.length)} kont`}
              </span>
            </div>

            {/* TRZY STANY, NIE DWA — ale nie takie, jak zakladano przy S-09.
                `null` to "odczyt sie nie udal" (wyjatek zlapany we frontmatterze).
                Pusta tablica to "odczyt sie udal, a baza odmowila" — NIE "nie ma kont";
                uzasadnienie przy samym komunikacie nizej, ustalenie F6 przegladu calosci.
                Trzeci stan to lista. Pokazanie jednego zamiast drugiego byloby
                twierdzeniem o stanie, ktorego nie znamy — ten sam wybor co przy
                liczniku limitu wyzej. */}
            {accounts === null ? (
              <p class="text-ink-muted mt-2 text-sm">
                Nie udało się odczytać przeglądu kont. Odśwież stronę za chwilę.
              </p>
            ) : accounts.length === 0 ? (
              /* USTALENIE F6 PRZEGLADU CALOSCI. Wczesniej stalo tu "Nie ma jeszcze
                 zadnych kont." — zdanie falszywe w JEDYNYM stanie, w jakim moze paść.
                 Bramka w SQL przepuszcza wolajacego tylko gdy `me.deleted_at is null`,
                 a listowany zbior filtruje `u.deleted_at is null`: administrator, ktory
                 przeszedl bramke, ZAWSZE widzi co najmniej wlasny wiersz. Zero wierszy
                 znaczy wiec odmowe bazy — nieodswiezony token w zadaniu PostgREST albo
                 role zdjeta miedzy `getUser()` a wywolaniem — a nie brak kont. */
              <p class="text-ink-muted mt-2 text-sm">
                Przegląd nie zwrócił żadnego wiersza. Lista zawsze zawiera co najmniej Twoje konto, więc to znaczy, że
                odczyt został odrzucony. Odśwież stronę, a jeśli to nie pomoże — zaloguj się ponownie.
              </p>
            ) : (
              <>
                <div class="mt-3 overflow-x-auto">
                  <table class="w-full text-left text-sm">
                    <thead class="text-ink-subtle text-xs">
                      <tr>
                        <th class="py-1 pr-4 font-medium">Konto</th>
                        <th class="py-1 pr-4 font-medium">Rola</th>
                        <th class="py-1 pr-4 font-medium">Rejestracja</th>
                        <th class="py-1 pr-4 text-right font-medium">Generacje</th>
                        <th class="py-1 pr-4 text-right font-medium">Dziś</th>
                        <th class="py-1 text-right font-medium">
                          <span class="sr-only">Zmiana roli</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody class="text-ink-muted">
                      {accounts.map((account) => (
                        <tr class="border-hairline border-t">
                          {/* `whitespace-nowrap`, NIE `break-all` ani `break-words`.
                              Adres e-mail nie ma spacji, wiec `break-words` nie ma gdzie
                              zlamac i zachowuje sie jak `break-all` — a ten rozbija adres
                              w srodku slowa ("damiano.krz / ywda@gmai / l.com"), co czyni
                              go nieczytelnym. Tabela ma `overflow-x-auto` na opakowaniu,
                              wiec wlasciwa odpowiedzia na ciasnote jest PRZEWINIECIE, nie
                              lamanie. Regres wprowadzony w S-10 przez dolozenie dwoch
                              kolumn; przedtem adres miescil sie w jednej linii. */}
                          <td class="text-ink py-2 pr-4">
                            <span class="whitespace-nowrap">{account.email}</span>
                            {/* Wlasne konto oznaczone, bo dzialanie na sobie jest DOZWOLONE
                                (PRD v4, OQ9) i klikajacy musi wiedziec, ze klika w siebie.
                                Osobna linia, zeby nie poszerzac kolumny o kolejne slowo. */}
                            {account.isSelf && <span class="text-ink-subtle block text-xs">to Ty</span>}
                          </td>
                          <td class="py-2 pr-4 whitespace-nowrap">{account.roleLabel}</td>
                          <td class="py-2 pr-4 whitespace-nowrap">{account.registeredLabel}</td>
                          <td class="py-2 pr-4 text-right">{account.generations}</td>
                          <td class="py-2 pr-4 text-right whitespace-nowrap">
                            {account.usedToday} z {account.ownLimit}
                          </td>
                          <td class="py-2 text-right">
                            <AccountRoleButton
                              client:load
                              accountId={account.id}
                              email={account.email}
                              role={account.role}
                              isSelf={account.isSelf}
                              isLastAdmin={account.isLastAdmin}
                            />
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                {/* Sufit bez komunikatu zamienia "widzisz wszystko" w "widzisz czesc"
                      bez sladu. Rowna liczba wierszy znaczy, ze lista MOGLA zostac obcieta —
                      nie ze zostala, bo kont moze byc dokladnie tyle. */}
                {accountsTruncated && (
                  <p class="text-ink-subtle mt-2 text-xs">
                    Pokazano pierwsze {accounts[0].rowLimit} kont, od najnowszego. Jeśli jest ich więcej, reszta nie
                    jest tu widoczna.
                  </p>
                )}

                <p class="text-ink-subtle mt-2 text-xs">
                  Przegląd pokazuje wyłącznie liczby. Nigdy nie pokaże treści cudzych tekstów.
                </p>
              </>
            )}
          </section>
        )
      }

      <nav class="mb-4 flex gap-2" aria-label="Zakładki panelu">
        {
          TABS.map((entry) => (
            <a href={entry.href} class:list={`${tabClass} ${tab === entry.key ? activeClass : idleClass}`}>
              {entry.label}
            </a>
          ))
        }
      </nav>

      {
        tab === "ranking" && (
          <nav class="mb-6 flex gap-2" aria-label="Format w rankingu">
            {FORMAT_TABS.map((entry) => (
              <a
                href={`/dashboard?tab=ranking&format=${entry.key}`}
                class:list={`${tabClass} ${format === entry.key ? activeClass : idleClass}`}
              >
                {entry.label}
              </a>
            ))}
          </nav>
        )
      }

      {
        tab === "ranking" ? (
          /* Ranking NIE dostaje `deletable` i to jest znaczacy brak, nie zapomnienie:
             ranking jest tablica wynikow do czytania, a zarzadzanie kolekcja dzieje sie
             w historii i w ulubionych. Nie "naprawiaj" tego, dokladajac tu flage. */
          <GenerationList
            items={items}
            ranked
            emptyTitle={
              format === "joke" ? "Żaden dowcip nie ma jeszcze oceny." : "Żadna historia nie ma jeszcze oceny."
            }
            emptyHint="Oceń tekst gwiazdkami w historii albo zaraz po wygenerowaniu — ranking pokazuje tylko ocenione pozycje."
          />
        ) : (
          <GenerationList
            items={items}
            deletable
            emptyTitle="Nie masz jeszcze ulubionych."
            emptyHint="Kliknij serce przy tekście, żeby trafił tutaj."
          />
        )
      }

      <p class="text-ink-subtle mt-8 text-center text-xs">
        <a href="/generations" class="hover:text-ink-muted hover:underline">Zobacz całą historię</a>
      </p>
    </div>
  </div>
</Layout>
