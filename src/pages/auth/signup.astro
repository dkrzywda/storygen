---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { messageForCode } from "@/lib/api-errors";

// Parametr niesie KOD, nie tresc. Wartosc nierozpoznana daje komunikat domyslny,
// nigdy samej wartosci — inaczej dowolny tekst z URL-a trafialby na ekran.
const errorCode = Astro.url.searchParams.get("error");
const error = errorCode === null ? null : messageForCode(errorCode);
---

<Layout title="Rejestracja">
  <div class="bg-app flex min-h-screen items-center justify-center p-4">
    <div class="border-hairline bg-panel text-ink w-full max-w-sm rounded-2xl border p-8 shadow-sm">
      <h1 class="text-ink mb-6 text-center text-2xl font-bold">Zarejestruj się</h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-ink-muted mt-4 text-center text-sm">
        Masz już konto? <a href="/auth/signin" class="text-brand hover:underline">Zaloguj się</a>
      </p>
    </div>
  </div>
</Layout>
